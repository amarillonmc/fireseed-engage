# 种火集结号 - Apache 生产入口保护 / Fireseed Engage - Apache production entry protection
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 阻止浏览器直接访问服务器内部目录 / Block direct browser access to server-internal directories
    RewriteRule ^(?:config|doc|includes|logs|sql|tests|tools)(?:/|$) - [F,L,NC]

    # 阻止隐藏文件与本地配置文件 / Block hidden files and local configuration files
    RewriteRule "(^|/)\." - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)$|.*\.(sql|log|ini|bak|dist)$)">
    Require all denied
</FilesMatch>
